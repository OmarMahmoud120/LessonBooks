# Local entrypoint forces Firebase emulators and mocked AI. Never add real keys here.
# A reviewed production entrypoint must inject secrets from Secret Manager.
OPENROUTER_API_KEY=replace-via-secret-manager
LIVE_AI_APPROVED=false
MAX_JOB_COST_USD=0
OCR_PROVIDER=local
# Cloudflare is limited to owned synthetic PDFs in the emulator runtime.
# Set approval only after approving a potentially billable development run.
CLOUDFLARE_OCR_APPROVED=false
CLOUDFLARE_OCR_MAX_REQUESTS=1
CLOUDFLARE_API_KEY=replace-via-runtime-injection
CLOUDFLARE_ACCOUNT_ID=replace-via-runtime-injection
# Cloud region, model/provider allowlists and retention require explicit decisions.
