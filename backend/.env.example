# Local entrypoint: Postgres + Keycloak + Garage (see compose.yaml) and mocked AI.
# The loopback defaults in backend/src/runtime-config.ts match the synthetic
# local-only compose credentials, so `npm run dev` works with no env file.
# Never add real keys here; a VPS deployment must inject secrets at runtime.
OPENROUTER_API_KEY=replace-via-secret-manager
LIVE_AI_APPROVED=false
MAX_JOB_COST_USD=0
OCR_PROVIDER=local
# Cloudflare is limited to owned synthetic PDFs in the local runtime.
# Set approval only after approving a potentially billable development run.
CLOUDFLARE_OCR_APPROVED=false
CLOUDFLARE_OCR_MAX_REQUESTS=1
CLOUDFLARE_API_KEY=replace-via-runtime-injection
CLOUDFLARE_ACCOUNT_ID=replace-via-runtime-injection
# Optional overrides for the local stack (defaults live in runtime-config.ts):
# POSTGRES_URL=postgres://lessonbooks:local-only-documents-db-password@127.0.0.1:5432/lessonbooks
# KEYCLOAK_ISSUER=http://127.0.0.1:8081/realms/lessonbooks
# KEYCLOAK_BACKCHANNEL_URL=http://127.0.0.1:8081
# S3_ENDPOINT=http://127.0.0.1:3900
# Model/provider allowlists, retention and spend limits require explicit decisions.
