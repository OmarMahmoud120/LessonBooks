{
  "realm": "lessonbooks",
  "displayName": "LessonBooks",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "ar"],
  "defaultLocale": "en",
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "clients": [
    {
      "clientId": "lessonbooks-site",
      "name": "LessonBooks website",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["http://127.0.0.1:5173/*"],
      "webOrigins": ["http://127.0.0.1:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:5173/*",
        "access.token.signed.response.alg": "RS256"
      },
      "protocolMappers": [
        {
          "name": "lessonbooks-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "lessonbooks-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "lessonbooks-mobile",
      "name": "LessonBooks mobile app",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["lessonbooks://auth", "http://127.0.0.1:19006/*"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "lessonbooks://auth",
        "access.token.signed.response.alg": "RS256"
      },
      "protocolMappers": [
        {
          "name": "lessonbooks-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "lessonbooks-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "lessonbooks-api",
      "name": "LessonBooks API service account",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-only-api-service-secret-0123456789",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "bearerOnly": false,
      "attributes": {
        "access.token.signed.response.alg": "RS256"
      }
    }
  ],
  "users": [
    {
      "username": "service-account-lessonbooks-api",
      "enabled": true,
      "serviceAccountClientId": "lessonbooks-api",
      "clientRoles": {
        "realm-management": ["view-users", "manage-users"]
      }
    },
    {
      "username": "local-parent",
      "enabled": true,
      "email": "local-parent@example.test",
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Parent",
      "credentials": [
        {
          "type": "password",
          "value": "SyntheticLocalParent2026",
          "temporary": false
        }
      ]
    }
  ]
}
